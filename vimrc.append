" 시스템 전역 vim-plug 경로
if empty(glob('/etc/vim/autoload/plug.vim'))
  echoerr "vim-plug not found!"
else
  execute 'source /etc/vim/autoload/plug.vim'
endif

call plug#begin('/usr/local/share/vim/plugged')

Plug 'prabirshrestha/vim-lsp'
Plug 'mattn/vim-lsp-settings'
Plug 'prabirshrestha/asyncomplete.vim'
Plug 'prabirshrestha/asyncomplete-lsp.vim'
Plug 'airblade/vim-rooter'
Plug 'itchyny/lightline.vim'
Plug 'tpope/vim-sensible'


call plug#end()

" LSP 관련 기본 설정
let g:lsp_diagnostics_enabled = 1
let g:lsp_auto_enable = 1
let g:asyncomplete_auto_popup = 1

set laststatus=2
set number

highlight LspReferenceText cterm=bold ctermfg=black ctermbg=lightgrey
highlight LspReferenceRead cterm=bold ctermfg=black ctermbg=lightgrey
highlight LspReferenceWrite cterm=bold ctermfg=black ctermbg=lightgrey
